<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version quemada en el assembly: multiappcli la pasa (-p:AppVersion); por defecto lee VERSION -->
    <AppVersion Condition="'$(AppVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\..\VERSION').Trim())</AppVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- dotnet watch (.NET 10): logs y media subida en runtime cambian mientras
       la app corre. Si el watcher los detecta (sobre todo archivos NUEVOS en
       wwwroot), Hot Reload truena con
       "Unexpected true - HotReloadMSBuildWorkspace.cs line 158".
       Se excluyen solo durante el build de diseÃ±o de dotnet watch, para no
       afectar el publish normal. -->
  <PropertyGroup Condition="'$(DotNetWatchBuild)' == 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);**/logs/**;**/wwwroot/media/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(AppVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <!-- AlmacÃ©n analÃ­tico de telemetrÃ­a (DuckDB embebido). La variante Full trae la librerÃ­a nativa. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.1" />
    <!-- Motor de firma de PDFs (sustituye a pdf_signature_replacer.py).
         PdfPig: localizar el texto; PDFsharp: dibujar, aplanar y cifrar;
         PDFtoImage (PDFium + SkiaSharp): rasterizar a 250 dpi. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.5.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Handlebars.Net" Version="2.5.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="scripts\pdf_signature_replacer.py" />
    <EmbeddedResource Include="scripts\assets\firma.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lefarma.UnitTests" />
    <Folder Include="Domain\Entities\EducacionMedica\" />
    <Folder Include="Domain\Interfaces\EducacionMedica\" />
    <Folder Include="Features\Asistencias\" />
    <Folder Include="Infrastructure\Data\Migrations\" />
    <Folder Include="Shared\Exceptions\" />
    <Folder Include="Validators\" />
  </ItemGroup>

</Project>
