{"nodes": [{"id": "instructivos_elaborar_plan_de_trabajo_elaborar_plan_de_trabajo", "label": "Elaborar Plan de Trabajo", "file_type": "document", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ask_ven_for_002_plan_de_trabajo_formato", "label": "ASK-VEN-FOR-002 Plan de Trabajo (formato) (referenciado, no incluido)", "file_type": "document", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ask_adm_for_001_solicitud_de_vi_ticos", "label": "ASK-ADM-FOR-001 Solicitud de Vi\u00e1ticos (referenciado, no incluido)", "file_type": "document", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_anual", "label": "Plan anual", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documento rector que recoge objetivos, estrategias y planes de acci\u00f3n acordados en la planeaci\u00f3n estrat\u00e9gica de la alta direcci\u00f3n; de \u00e9l derivan las metas de ventas/desplazamiento (ASK-VEN-FOR-001), el plan de trabajo mensual de los ejecutivos y la programaci\u00f3n anual de talleres m\u00e9dicos (ASK-CEM-FOR-003)."}, {"id": "productos_nuevos_tradicionales", "label": "Productos Nuevos vs Tradicionales (criterio COFEPRIS)", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Definici\u00f3n compartida en todos los instructivos de Ventas: producto NUEVO = patente vigente y registro sanitario COFEPRIS menor a 8 a\u00f1os; TRADICIONAL = registro mayor a 8 a\u00f1os. Separa las metas de ventas/desplazamiento en pesos y piezas en ASK-VEN-FOR-001."}, {"id": "cpm_consumo_promedio_mensual", "label": "CPM (Consumo Promedio Mensual)", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indicador de demanda por unidad m\u00e9dica que los ejecutivos monitorean (propio y de competencia) para gestionar cartas de creaci\u00f3n/incremento de CPM y detectar unidades de consumo potencial en el plan de trabajo."}, {"id": "vi_ticos", "label": "Vi\u00e1ticos (definici\u00f3n y pol\u00edtica)", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conjunto de provisiones/dinero para viajes for\u00e1neos; la Coordinaci\u00f3n Administrativa analiza los costos de mercado cada enero para fijar topes m\u00e1ximos y toda solicitud requiere revisi\u00f3n de Gerencia General y autorizaci\u00f3n de Direcci\u00f3n Corporativa (aplicable a Ventas y a Educaci\u00f3n M\u00e9dica)."}], "edges": [{"source": "instructivos_elaborar_plan_de_trabajo_elaborar_plan_de_trabajo", "target": "proceso_de_ventas_imss", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lefarma.docs/apps/educacion-medica/vault/Instructivos/Elaborar Plan de Trabajo.md", "source_location": null, "weight": 1.0}, {"source": "instructivos_elaborar_plan_de_trabajo_elaborar_plan_de_trabajo", "target": "procedimientos_procedimiento_normalizado_de_ope