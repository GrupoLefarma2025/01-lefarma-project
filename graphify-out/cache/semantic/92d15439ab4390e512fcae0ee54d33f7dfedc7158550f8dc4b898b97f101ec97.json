{"nodes": [{"id": "2026_06_22_multi_app_foundation_design_two_build_model", "label": "Two env-driven builds via BASE_URL_PATH", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two builds from one codebase (root Gastos + /CxP/ shell), each IIS virtual app points to its own dist; vite.config.ts + App.tsx basename already implement env-driven base+basename so the root build stays untouched; same origin \u2192 shared localStorage \u2192 SSO free."}, {"id": "2026_06_22_multi_app_foundation_design_app_tree_selection", "label": "App tree selection on import.meta.env.BASE_URL", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App.tsx renders <BaseAppRoutes> when BASE_URL === '/CxP/' else <AppRoutes>; one tree per build \u2192 no route-path collisions."}, {"id": "2026_06_22_multi_app_foundation_design_localstorage_sso", "label": "Same-origin localStorage SSO", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both builds share one origin \u2192 shared localStorage (accessToken, user) makes cross-app SSO automatic with no re-login."}, {"id": "2026_06_22_multi_app_foundation_design_auth_relocation", "label": "Auth/api relocation to shared/ (shims \u2192 codemod)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "63 import statements across ~55 files; Phase 1a moves files + one-line export * shims (green), Phase 1b codemods imports and deletes shims; big-bang would exceed the 800-line review budget."}, {"id": "2026_06_22_multi_app_foundation_design_require_auth", "label": "RequireAuth full-page redirect guard", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "window.location.href = '/login?return=' + encodeURIComponent(path) to the EXISTING root login (navigate cannot cross root\u2194/CxP/ bundles); Login honors ?return= safelisted to /CxP/ (open-redirect guard); no context-selection blocking."}], "edges": [{"source": "2026_06_22_multi_app_foundation_design_two_build_model", "target": "2026_06_22_multi_app_foundation_proposal_change", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06_22_multi_app_foundation_design_two_build_model", "target": "2026_06_22_multi_app_foundation_design_app_tree_selection", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06_22_multi_app_foundation_design_two_build_model", "target": "2026_06_22_multi_app_foundation_design_localstorage_sso", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-06-22-multi-app-foundation/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06_22_multi_app_foundation_design_app_tree_selection", "target": "base_app_spec_capability", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/