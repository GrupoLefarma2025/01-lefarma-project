{"nodes": [{"id": "diagramas_diagrama_del_proceso_de_ventas_diagrama_del_proceso_de_ventas", "label": "Diagrama del Proceso de Ventas", "file_type": "document", "source_file": "lefarma.docs/apps/educacion-medica/vault/Diagramas/Diagrama del Proceso de Ventas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "proceso_de_ventas_imss", "label": "Proceso de Ventas IMSS (proceso maestro)", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Diagramas/Diagrama del Proceso de Ventas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proceso ASK-VEN-DPD-001 estructurado en ciclo Planea-Ejecuta-Verifica-Mejora (mensual/semanal). Los objetivos de desplazamiento deben estar autorizados por Direcci\u00f3n Corporativa antes del a\u00f1o y sirven de base para comisiones; el cumplimiento del plan de trabajo debe superar el 90% (verificado v\u00eda GPS) y el personal activo al cierre de mes debe ser al menos el 80% para que Gerencia General/Gerente IMSS cobren comisi\u00f3n. Variante descentralizada en ASK-VEN-DPD-002."}, {"id": "app_control_at_t", "label": "App Control AT&T (plataforma m\u00f3vil de visitas)", "file_type": "concept", "source_file": "lefarma.docs/apps/educacion-medica/vault/Diagramas/Diagrama del Proceso de Ventas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aplicaci\u00f3n m\u00f3vil (v1.35) autorizada por Asokam para registrar inicio/fin de cada visita con GPS; el Monitorista GPS descarga su reporte semanal (lunes/viernes) que alimenta el indicador de cumplimiento del plan de trabajo. Es obligatorio reportar en ella seg\u00fan el PNO."}], "edges": [{"source": "diagramas_diagrama_del_proceso_de_ventas_diagrama_del_proceso_de_ventas", "target": "proceso_de_ventas_imss", "relation": "references", "confidence": "EXTRACTED", "con