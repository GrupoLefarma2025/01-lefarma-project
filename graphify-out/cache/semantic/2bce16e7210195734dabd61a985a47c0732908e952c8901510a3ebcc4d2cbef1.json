{"nodes": [{"id": "rules_rendering_hydration_no_flicker", "label": "Prevent Hydration Mismatch Without Flickering", "file_type": "document", "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For client-only values (localStorage, cookies), a synchronous inline script updates the DOM before React hydrates \u2014 avoiding both SSR breakage (localStorage undefined on server) and post-hydration flicker. Useful for theme toggles, preferences, and auth state. Impact: MEDIUM."}], "edges": [{"source": "rules_rendering_hydration_no_flicker", "target": "rules_rendering_hydration_suppress_warning", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "hydration_mismatch_handling", "label": "Hydration Mismatch Handling", "nodes": ["rules_rendering_hydration_no_flicker", "rules_rendering_hydration_suppress_warning", "concept_suppress_hydration_warning"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md"}]}