{"nodes": [{"id": "rules_rerender_use_deferred_value", "label": "Use useDeferredValue for Expensive Derived Renders", "file_type": "document", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deferred value lags behind the input update, letting React prioritize the input and render the expensive result when idle. Must wrap the computation in useMemo keyed on the deferred value, or it still runs every render. Impact: MEDIUM."}, {"id": "concept_use_deferred_value", "label": "useDeferredValue", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook that returns a lagging value so input updates win and expensive derived renders happen when the thread is idle."}], "edges": [{"source": "rules_rerender_use_deferred_value", "target": "concept_use_deferred_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "weight": 1.0}, {"source": "rules_rerender_use_deferred_value", "target": "concept_use_transition", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "weight": 1.0}], "hyperedges": []}