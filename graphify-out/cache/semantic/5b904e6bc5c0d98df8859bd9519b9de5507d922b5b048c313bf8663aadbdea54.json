{"nodes": [{"id": "caratulas_por_cuenta_proveedor_design_migration_025", "label": "Migration 025_caratula_por_cuenta.sql", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent manual SQL (never dotnet ef migrations): adds caratula_path to live+staging cuenta tables, adds id_cuen to staging (drift fix), back-fills ~14 legacy caratulas onto each supplier's FIRST ACTIVE account via MIN(id_cuenta) (IDENTITY PK = canonical monotonic insertion-order proxy, no ties), keeps legacy column nullable for rollback."}, {"id": "caratulas_por_cuenta_proveedor_design_estatus_routing", "label": "Estatus-driven caratula routing (DeterminarRutaCaratula)", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nuevo/Rechazado \u2192 direct write; Aprobado/EditadoPendiente \u2192 staging; unknown estatus \u2192 Conflict. Exhaustiveness guard: pure helper with explicit _ rejection, no silent default; a new estatus MUST be added here or it throws."}, {"id": "caratulas_por_cuenta_proveedor_design_escribir_directo", "label": "EscribirCaratulaDirectoAsync (direct write)", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets CaratulaPath + FechaModificacion + SaveChanges; no staging row, no diff, no estatus flip. Also removes the orphan-detalle 409 (the account always exists)."}, {"id": "caratulas_por_cuenta_proveedor_design_stagear_caratula", "label": "StagearCaratulaAsync (standalone staging upload)", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clones live supplier state into a staging row so GenerarDiff yields exactly ONE caratula entry (diff length == 1); target cuenta gets CaratulaPath=newPath with IdCuen preserved; estatus flips to EditadoPendiente; live caratula untouched until approval."}, {"id": "caratulas_por_cuenta_proveedor_design_generar_diff", "label": "GenerarDiff caratula CampoDiff", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campo = CuentasFormaPago[{id}].Caratula; human label Caratula cuenta \u2022\u2022{last4} actualizada / agregada / eliminada (two literal U+2022 bullets, accents preserved); ValorAnterior/ValorNuevo store the file paths (null for first-time)."}, {"id": "caratulas_por_cuenta_proveedor_design_ultimos4", "label": "Ultimos4 helper (CLABE-preferred last-4)", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RIGHT(Clabe,4) when CLABE present (most stable account identifier, already used by GenerarDiff display value), else RIGHT(NumeroCuenta,4), else literal '????'."}, {"id": "caratulas_por_cuenta_proveedor_design_autorizar_edicion", "label": "AutorizarEdicionAsync promote/reject", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promotion loop copies staged CaratulaPath to the live cuenta; reject needs NO revert code \u2014 live cuenta was never touched during staging, so the caratula reverts to its prior value by construction; estatus returns to Aprobado."}, {"id": "caratulas_por_cuenta_proveedor_design_proveedor_service", "label": "ProveedorService caratula lifecycle", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "caratulas_por_cuenta_proveedor_design_proveedores_controller", "label": "ProveedoresController cuenta-caratula endpoints", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST {id}/cuentas/{idCuen}/caratula (multipart, jpg/png/gif/webp/pdf, 10MB, caratula_cuenta_{idCuen}_{guid}{ext}), GET {id}/caratulas for the modal; old POST/DELETE {id}/caratula become a 410 Gone deprecated shim (bulk-upload CSV audit pending)."}, {"id": "caratulas_por_cuenta_proveedor_design_410_shim", "label": "410 Gone deprecated shim for old /{id}/caratula", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old supplier-level caratula routes return 410 with a migration message pointing to the new cuenta-scoped routes; hard-remove deferred (possible bulk-upload CSV callers)."}, {"id": "caratulas_por_cuenta_proveedor_design_caratulas_preview_modal", "label": "CaratulasPreviewModal", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches getCaratulas(proveedorId) on open; one entry per caratula (last-4 + preview button reusing the existing fullscreen viewer); empty state 'No hay caratulas para este proveedor.'; shadcn Dialog + ScrollArea + Badge."}, {"id": "caratulas_por_cuenta_proveedor_design_proveedor_api", "label": "proveedorApi caratula functions", "file_type": "concept", "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalized into proveedorApi (uploadCuentaCaratula multipart, deleteCuentaCaratula, getCaratulas) alongside autorizar/rechazar/bulkUpload instead of raw inline API.post."}], "edges": [{"source": "caratulas_por_cuenta_proveedor_design_migration_025", "target": "caratulas_por_cuenta_proveedor_design_id_cuen_drift", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "weight": 1.0}, {"source": "caratulas_por_cuenta_proveedor_design_estatus_routing", "target": "caratulas_por_cuenta_proveedor_design_estatus_proveedor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "weight": 1.0}, {"source": "caratulas_por_cuenta_proveedor_design_estatus_routing", "target": "caratulas_por_cuenta_proveedor_design_escribir_directo", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "weight": 1.0}, {"source": "caratulas_por_cuenta_proveedor_design_estatus_routing", "target": "caratulas_por_cuenta_proveedor_design_stagear_caratula", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/caratulas-por-cuenta-proveedor/design.md", "source_location": null, "weight": 1.0}, {"source": "caratulas_por_cuenta_proveedor_design_estatus_routing", "target": "caratulas_por_cuenta_proveedor_design_proveedor_service", "relation": "conceptually_related_to", "confidence