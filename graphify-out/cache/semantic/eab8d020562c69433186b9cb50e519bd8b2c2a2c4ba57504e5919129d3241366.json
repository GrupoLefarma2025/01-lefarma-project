{"nodes": [{"id": "2026_06_22_gastos_migration_design_gastosroutes", "label": "GastosRoutes reusable route module", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single module of relative <Route> children mounted in both builds (root byte-identical, shell under /CxP/gastos); variant 'root'|'subtree' gates the unauth index (Hero vs redirect-to-login); root-build regression is the core hazard so every path including <Navigate to> is relative. Chosen over routes factory and two parallel defs (~30-route drift)."}, {"id": "2026_06_22_gastos_migration_design_require_auth", "label": "RequireAuth subtree-aware auth guard", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "loginPath prop + <Navigate> (shell is a single bundle so Navigate works, replacing foundation's window.location.href); checks AUTH ONLY, never context; return URL preserved via ?return=."}, {"id": "2026_06_22_gastos_migration_design_login", "label": "Config-driven Login (2-step global / 3-step Gastos)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One component with requireContextSelection + redirectTo props; avoids duplicating the 600-line form and fragile URL\u2194behavior coupling; redirectTo replaces hard-coded navigate('/dashboard')."}, {"id": "2026_06_22_gastos_migration_design_base_app_routes", "label": "BaseAppRoutes shell navigation rework", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/ becomes <Navigate> (auth\u2192/hub, unauth\u2192/login), /login added OUTSIDE RequireAuth, /hub\u2192<Home/>, Gastos subtree mounted under gastos; blast radius 2 files + 1 registry line."}, {"id": "2026_06_22_gastos_migration_design_shell_layout", "label": "ShellLayout nav rework (nav / to /hub)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "2026_06_22_gastos_migration_design_app_registry", "label": "Static App Registry (_registry.ts)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code-level registry, no backend call for the launcher; adding an app is code-only; gastos flipped from disabled to enabled."}], "edges": [{"source": "2026_06_22_gastos_migration_design_gastosroutes", "target": "app_routing_spec_subtree_mounting", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06_22_gastos_migration_design_login", "target": "app_routing_spec_global_login_route", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06_22_gastos_migration_design_login", "target": "gastos_app_spec_three_step_login", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/archive/2026-06-22-gastos-migration/design.md", "source_location": null, "weight": 1.0}, {"source": "2026_06