# Clave que deben mandar los clientes en el header x-api-key.
API_KEY=cambia-esta-clave-por-una-aleatoria-de-32+-caracteres

# URL publica detras de Traefik (se usa para armar las URLs de las capturas).
BASE_URL=https://capturas.app.grupolefarma.com.mx

PORT=8099
MAX_CONCURRENCIA=2
INSTALAR_OPENCODE=true

# Resolucion de coordenadas -> lugar del catalogo de ClickBus.
# Radio (km) para aceptar la terminal mas cercana sin geocodificar la ciudad.
RADIO_DIRECTO_KM=40
# Geocodificacion inversa (Nominatim/OpenStreetMap) para ciudades sin terminales con coords.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=viaticos-capturas/1.0 (+https://capturas.app.grupolefarma.com.mx)
NOMINATIM_TIMEOUT_MS=8000

# Modo agentico (OpenCode + Playwright MCP). Deshabilitado por defecto.
ENABLE_AGENTICO=1
OPENCODE_MODEL=tokenharbor/deepseek-v4.1-flash:free
AGENTICO_TIMEOUT_MS=300000
